   "updated": 1750000000000,
   "link": null,
   "locked": false,
   "text": "net/http mux\n\nGET  /{$}                 -> index\nPOST /timers               -> create\nGET  /timers/{id}         -> select\nDELETE /timers/{id}       -> remove\nGET  /timers/{id}/display\n     <- 1s poll\nPOST /timers/{id}/{action}\n  start/pause/reset/skip/lap\nPOST /timers/{id}/steps\nDELETE /timers/{id}/steps/{i}\nPOST .../steps/{i}/move/{dir}",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "mux",
   "originalText": "net/http mux\n\nGET  /{$}                 -> index\nPOST /timers               -> create\nGET  /timers/{id}         -> select\nDELETE /timers/{id}       -> remove\nGET  /timers/{id}/display\n     <- 1s poll\nPOST /timers/{id}/{action}\n  start/pause/reset/skip/lap\nPOST /timers/{id}/steps\nDELETE /timers/{id}/steps/{i}\nPOST .../steps/{i}/move/{dir}",
   "lineHeight": 1.25
  },
